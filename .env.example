# Server
PORT=3000
NODE_ENV=development
APP_NAME=FinMate

# Database (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=finmate_local
DB_PORT=3306

# Production database (optional, e.g. Aiven)
# DB_SSL=true
# DB_CA_PATH=/path/to/ca.pem

# Auth / Session
JWT_SECRET=your-jwt-secret-change-me
SESSION_SECRET=your-session-secret-change-me

# Set true to auto-initialize tables on boot in production
# INIT_DB=true

# Email (used by notification service)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-password
