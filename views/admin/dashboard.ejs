<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --secondary-gradient: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            --success-color: #10b981;
            --warning-color: #f59e0b;
            --info-color: #3b82f6;
            --danger-color: #ef4444;
            --dark-color: #1f2937;
            --light-bg: #f8fafc;
            --card-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
            --hover-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: var(--light-bg);
            min-height: 100vh;
            line-height: 1.6;
            color: #374151;
            overflow-x: hidden;
        }

        /* Statistics Cards */
        .stat-card {
            border: none;
            border-radius: 20px;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            background: white;
            box-shadow: var(--card-shadow);
            overflow: hidden;
            position: relative;
            border: 1px solid rgba(0,0,0,0.03);
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--info-color);
            transform: scaleX(0);
            transition: transform 0.3s ease;
        }

        .stat-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--hover-shadow);
        }

        .stat-card:hover::before {
            transform: scaleX(1);
        }

        .stat-card-primary::before { background: var(--info-color); }
        .stat-card-success::before { background: var(--success-color); }
        .stat-card-warning::before { background: var(--warning-color); }
        .stat-card-info::before { background: var(--info-color); }
        .stat-card-dark::before { background: var(--dark-color); }
        .stat-card-danger::before { background: var(--danger-color); }

        .stat-icon {
            width: 70px;
            height: 70px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.75rem;
            transition: all 0.3s ease;
        }

        .stat-card:hover .stat-icon {
            transform: scale(1.1) rotate(5deg);
        }

        .stat-icon-primary { background: linear-gradient(135deg, rgba(59, 130, 246, 0.15), rgba(59, 130, 246, 0.05)); color: var(--info-color); }
        .stat-icon-success { background: linear-gradient(135deg, rgba(16, 185, 129, 0.15), rgba(16, 185, 129, 0.05)); color: var(--success-color); }
        .stat-icon-warning { background: linear-gradient(135deg, rgba(245, 158, 11, 0.15), rgba(245, 158, 11, 0.05)); color: var(--warning-color); }
        .stat-icon-info { background: linear-gradient(135deg, rgba(59, 130, 246, 0.15), rgba(59, 130, 246, 0.05)); color: var(--info-color); }
        .stat-icon-dark { background: linear-gradient(135deg, rgba(31, 41, 55, 0.15), rgba(31, 41, 55, 0.05)); color: var(--dark-color); }
        .stat-icon-danger { background: linear-gradient(135deg, rgba(239, 68, 68, 0.15), rgba(239, 68, 68, 0.05)); color: var(--danger-color); }

        /* Welcome Card */
        .welcome-card {
            background: var(--primary-gradient);
            border: none;
            border-radius: 24px;
            color: white;
            overflow: hidden;
            position: relative;
            box-shadow: var(--card-shadow);
        }

        .welcome-card::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(45deg, transparent, rgba(255,255,255,0.1), transparent);
            transform: rotate(45deg);
            animation: shine 3s infinite;
        }

        @keyframes shine {
            0% { transform: translateX(-100%) translateY(-100%) rotate(45deg); }
            100% { transform: translateX(100%) translateY(100%) rotate(45deg); }
        }

        /* Quick Actions */
        .quick-action-btn {
            border: none;
            border-radius: 20px;
            padding: 2rem 1.5rem;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            background: white;
            box-shadow: var(--card-shadow);
            text-decoration: none;
            color: inherit;
            display: block;
            height: 100%;
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(0,0,0,0.03);
        }

        .quick-action-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
            transition: left 0.5s;
        }

        .quick-action-btn:hover {
            transform: translateY(-8px);
            box-shadow: var(--hover-shadow);
            text-decoration: none;
            color: inherit;
        }

        .quick-action-btn:hover::before {
            left: 100%;
        }

        .action-icon {
            width: 80px;
            height: 80px;
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.25rem;
            margin: 0 auto 1.25rem;
            transition: all 0.3s ease;
        }

        .quick-action-btn:hover .action-icon {
            transform: scale(1.15);
        }

        /* User Badge */
        .user-badge {
            background: var(--primary-gradient);
            border: none;
            border-radius: 30px;
            padding: 0.75rem 1.5rem;
            color: white;
            font-weight: 600;
            box-shadow: 0 8px 20px rgba(102, 126, 234, 0.3);
            transition: all 0.3s ease;
        }

        .user-badge:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 25px rgba(102, 126, 234, 0.4);
        }

        /* Cards */
        .card {
            border: none;
            border-radius: 20px;
            box-shadow: var(--card-shadow);
            background: white;
            border: 1px solid rgba(0,0,0,0.03);
            transition: all 0.3s ease;
        }

        .card:hover {
            box-shadow: var(--hover-shadow);
        }

        .card-header {
            background: white;
            border-bottom: 1px solid rgba(0,0,0,0.06);
            padding: 1.75rem 2rem;
            font-weight: 700;
            font-size: 1.1rem;
            border-radius: 20px 20px 0 0 !important;
        }

        /* System Status */
        .system-status {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem 0;
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }

        .system-status:last-child {
            border-bottom: none;
        }

        .status-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            animation: pulse 2s infinite;
            flex-shrink: 0;
        }

        .status-online { background: var(--success-color); }
        .status-offline { background: var(--danger-color); }

        @keyframes pulse {
            0%, 100% {
                opacity: 1;
                box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
            }
            50% {
                opacity: 0.8;
                box-shadow: 0 0 0 10px rgba(16, 185, 129, 0);
            }
        }

        /* Buttons */
        .btn {
            border-radius: 12px;
            font-weight: 600;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            padding: 0.875rem 1.5rem;
            border: none;
        }

        .btn-outline-primary:hover,
        .btn-outline-success:hover,
        .btn-outline-warning:hover,
        .btn-outline-info:hover,
        .btn-outline-dark:hover,
        .btn-outline-secondary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        }

        /* Loading Animation */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .animate-fade-in {
            animation: fadeInUp 0.6s ease-out;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb {
            background: var(--info-color);
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #2563eb;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .container-fluid.py-4 {
                padding: 1rem !important;
            }
            .stat-card {
                margin-bottom: 1rem;
            }
            .welcome-card {
                padding: 2rem 1.5rem !important;
            }
            .quick-action-btn {
                padding: 1.5rem 1rem;
                margin-bottom: 1rem;
            }
            .action-icon {
                width: 60px;
                height: 60px;
                font-size: 1.75rem;
            }
            .user-badge {
                padding: 0.5rem 1rem;
                font-size: 0.875rem;
            }
        }

        @media (max-width: 576px) {
            .welcome-card h3 {
                font-size: 1.5rem;
            }
            .stat-icon {
                width: 50px;
                height: 50px;
                font-size: 1.25rem;
            }
            .card-header {
                padding: 1.25rem 1.5rem;
            }
            .system-status {
                padding: 0.75rem 0;
            }
        }
    </style>
</head>
<body>
    <%- include('../partials/sidebar', { user: user, currentPage: 'dashboard' }) %>
    <div class="fm-main">
        <nav class="fm-topbar">
            <div class="fm-topbar-left">
                <a class="fm-topbar-brand" href="/admin/dashboard">
                    <span class="fm-topbar-brand-icon"><i class="fas fa-chart-line"></i></span>
                    <span class="fm-topbar-brand-text">FinMate</span>
                </a>
                <button class="fm-topbar-hamburger" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
                <span class="fm-topbar-title">Admin Dashboard</span>
            </div>
            <div class="fm-topbar-right">
                <a href="/admin/notifications"><i class="fas fa-bell"></i></a>
                <a href="/auth/logout" class="logout-link"><i class="fas fa-sign-out-alt"></i></a>
            </div>
        </nav>

        <!-- Main Content Area -->
        <div class="container-fluid py-4 animate-fade-in">
            <!-- Success/Error Messages -->
            <% if (locals.success) { %>
                <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                    <i class="fas fa-check-circle me-2"></i>
                    <%= locals.success %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>
            
            <% if (locals.error) { %>
                <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    <%= locals.error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <!-- Welcome Banner -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="welcome-card p-5">
                        <div class="row align-items-center">
                            <div class="col-lg-8">
                                <h3 class="fw-bold mb-3">Welcome to Admin Panel</h3>
                                <p class="mb-0 opacity-90 fs-6">Manage users, budgets, expenses, and system-wide settings from this centralized dashboard. Everything you need to oversee your financial operations.</p>
                            </div>
                            <div class="col-lg-4 text-lg-end text-center mt-3 mt-lg-0">
                                <i class="fas fa-rocket fa-5x opacity-25"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Statistics Cards -->
            <div class="row mb-4">
                <div class="col-xxl-2 col-xl-3 col-lg-4 col-md-6 mb-4">
                    <div class="stat-card stat-card-primary h-100">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <h6 class="text-uppercase text-muted small fw-bold mb-2">Total Users</h6>
                                    <h2 class="fw-bold text-dark mb-1 display-6"><%= stats && stats.totalUsers ? stats.totalUsers : 0 %></h2>
                                    <span class="text-success small fw-bold">
                                        <i class="fas fa-arrow-up me-1"></i>Active
                                    </span>
                                </div>
                                <div class="stat-icon stat-icon-primary">
                                    <i class="fas fa-users"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xxl-2 col-xl-3 col-lg-4 col-md-6 mb-4">
                    <div class="stat-card stat-card-success h-100">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <h6 class="text-uppercase text-muted small fw-bold mb-2">Total Budgets</h6>
                                    <h2 class="fw-bold text-dark mb-1 display-6"><%= stats && stats.totalBudgets ? stats.totalBudgets : 0 %></h2>
                                    <span class="text-success small fw-bold">
                                        <i class="fas fa-check-circle me-1"></i>Active
                                    </span>
                                </div>
                                <div class="stat-icon stat-icon-success">
                                    <i class="fas fa-wallet"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xxl-2 col-xl-3 col-lg-4 col-md-6 mb-4">
                    <div class="stat-card stat-card-warning h-100">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <h6 class="text-uppercase text-muted small fw-bold mb-2">Total Expenses</h6>
                                    <h2 class="fw-bold text-dark mb-1 display-6"><%= stats && stats.totalExpenses ? stats.totalExpenses : 0 %></h2>
                                    <span class="text-warning small fw-bold">
                                        <i class="fas fa-clock me-1"></i>Tracked
                                    </span>
                                </div>
                                <div class="stat-icon stat-icon-warning">
                                    <i class="fas fa-money-bill-wave"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xxl-2 col-xl-3 col-lg-4 col-md-6 mb-4">
                    <div class="stat-card stat-card-info h-100">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <h6 class="text-uppercase text-muted small fw-bold mb-2">Pending Expenses</h6>
                                    <h2 class="fw-bold text-dark mb-1 display-6"><%= stats && stats.pendingExpenses ? stats.pendingExpenses : 0 %></h2>
                                    <span class="text-info small fw-bold">
                                        <i class="fas fa-hourglass-half me-1"></i>Awaiting Review
                                    </span>
                                </div>
                                <div class="stat-icon stat-icon-info">
                                    <i class="fas fa-clock"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xxl-2 col-xl-3 col-lg-4 col-md-6 mb-4">
                    <div class="stat-card stat-card-dark h-100">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <h6 class="text-uppercase text-muted small fw-bold mb-2">Active Teams</h6>
                                    <h2 class="fw-bold text-dark mb-1 display-6"><%= stats && stats.totalTeams ? stats.totalTeams : 0 %></h2>
                                    <span class="text-success small fw-bold">
                                        <i class="fas fa-check me-1"></i>Active
                                    </span>
                                </div>
                                <div class="stat-icon stat-icon-dark">
                                    <i class="fas fa-sitemap"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xxl-2 col-xl-3 col-lg-4 col-md-6 mb-4">
                    <div class="stat-card stat-card-danger h-100">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <h6 class="text-uppercase text-muted small fw-bold mb-2">Notifications</h6>
                                    <h2 class="fw-bold text-dark mb-1 display-6"><%= stats && stats.pendingNotifications ? stats.pendingNotifications : 0 %></h2>
                                    <span class="text-warning small fw-bold">
                                        <i class="fas fa-bell me-1"></i>Unread
                                    </span>
                                </div>
                                <div class="stat-icon stat-icon-danger">
                                    <i class="fas fa-bell"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions & System Info -->
            <div class="row">
                <!-- Quick Actions -->
                <div class="col-xl-8 col-lg-7 mb-4">
                    <div class="card h-100">
                        <div class="card-header d-flex align-items-center">
                            <i class="fas fa-bolt me-3 text-warning fs-5"></i>
                            <h5 class="card-title mb-0 fw-bold">Quick Actions</h5>
                        </div>
                        <div class="card-body p-4">
                            <div class="row g-3">
                                <div class="col-xxl-4 col-lg-6 col-md-6">
                                    <a href="/admin/users/add" class="quick-action-btn text-center">
                                        <div class="action-icon bg-primary bg-opacity-10 text-primary">
                                            <i class="fas fa-user-plus"></i>
                                        </div>
                                        <h6 class="fw-bold mb-2">Add User</h6>
                                        <p class="text-muted small mb-0">Create new user account with roles</p>
                                    </a>
                                </div>
                                <div class="col-xxl-4 col-lg-6 col-md-6">
                                    <a href="/admin/budgets/create" class="quick-action-btn text-center">
                                        <div class="action-icon bg-success bg-opacity-10 text-success">
                                            <i class="fas fa-wallet"></i>
                                        </div>
                                        <h6 class="fw-bold mb-2">Create Budget</h6>
                                        <p class="text-muted small mb-0">Set up new budget allocation</p>
                                    </a>
                                </div>
                                <div class="col-xxl-4 col-lg-6 col-md-6">
                                    <a href="/admin/expenses" class="quick-action-btn text-center">
                                        <div class="action-icon bg-warning bg-opacity-10 text-warning">
                                            <i class="fas fa-money-bill-wave"></i>
                                        </div>
                                        <h6 class="fw-bold mb-2">Manage Expenses</h6>
                                        <p class="text-muted small mb-0">Review and approve expenses</p>
                                    </a>
                                </div>
                                <div class="col-xxl-4 col-lg-6 col-md-6">
                                    <a href="/admin/teams" class="quick-action-btn text-center">
                                        <div class="action-icon bg-info bg-opacity-10 text-info">
                                            <i class="fas fa-users-cog"></i>
                                        </div>
                                        <h6 class="fw-bold mb-2">Manage Teams</h6>
                                        <p class="text-muted small mb-0">Organize team structures</p>
                                    </a>
                                </div>
                                <div class="col-xxl-4 col-lg-6 col-md-6">
                                    <a href="/admin/notifications" class="quick-action-btn text-center">
                                        <div class="action-icon bg-dark bg-opacity-10 text-dark">
                                            <i class="fas fa-bell"></i>
                                        </div>
                                        <h6 class="fw-bold mb-2">Notifications</h6>
                                        <p class="text-muted small mb-0">View system alerts</p>
                                    </a>
                                </div>
                                <div class="col-xxl-4 col-lg-6 col-md-6">
                                    <a href="/admin/reports" class="quick-action-btn text-center">
                                        <div class="action-icon bg-danger bg-opacity-10 text-danger">
                                            <i class="fas fa-chart-bar"></i>
                                        </div>
                                        <h6 class="fw-bold mb-2">Reports</h6>
                                        <p class="text-muted small mb-0">Access analytics</p>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- System Info -->
                <div class="col-xl-4 col-lg-5 mb-4">
                    <div class="card h-100">
                        <div class="card-header d-flex align-items-center">
                            <i class="fas fa-info-circle me-3 text-primary fs-5"></i>
                            <h6 class="card-title mb-0 fw-bold">System Information</h6>
                        </div>
                        <div class="card-body p-4">
                            <div class="system-status">
                                <div class="status-dot status-online"></div>
                                <div class="flex-grow-1">
                                    <strong class="d-block mb-1">System Status</strong>
                                    <span class="text-success">All Systems Operational</span>
                                </div>
                            </div>
                            <div class="system-status">
                                <i class="fas fa-database text-info fs-5"></i>
                                <div class="flex-grow-1">
                                    <strong class="d-block mb-1">Database</strong>
                                    <span class="text-success">Connected & Healthy</span>
                                </div>
                            </div>
                            <div class="system-status">
                                <i class="fas fa-clock text-warning fs-5"></i>
                                <div class="flex-grow-1">
                                    <strong class="d-block mb-1">Server Time</strong>
                                    <span id="server-time" class="text-muted"><%= new Date().toLocaleString() %></span>
                                </div>
                            </div>
                            <div class="system-status">
                                <i class="fas fa-user-shield text-primary fs-5"></i>
                                <div class="flex-grow-1">
                                    <strong class="d-block mb-1">Your Role</strong>
                                    <span class="badge bg-primary"><%= user.role_name %></span>
                                </div>
                            </div>
                            <div class="system-status">
                                <i class="fas fa-sign-in-alt text-success fs-5"></i>
                                <div class="flex-grow-1">
                                    <strong class="d-block mb-1">Last Login</strong>
                                    <span class="text-muted">Recently</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div><!-- end fm-main -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Update server time every second
            function updateServerTime() {
                const now = new Date();
                const options = { 
                    weekday: 'long', 
                    year: 'numeric', 
                    month: 'long', 
                    day: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit',
                    second: '2-digit'
                };
                const timeElement = document.getElementById('server-time');
                if (timeElement) {
                    timeElement.textContent = now.toLocaleString('en-US', options);
                }
            }
            setInterval(updateServerTime, 1000);
            updateServerTime();

            // Add loading animations to cards
            const statsCards = document.querySelectorAll('.stat-card');
            statsCards.forEach((card, index) => {
                card.style.animationDelay = `${index * 0.1}s`;
            });

            // Auto-dismiss alerts after 5 seconds
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                setTimeout(() => {
                    if (alert.parentNode) {
                        const bsAlert = new bootstrap.Alert(alert);
                        bsAlert.close();
                    }
                }, 5000);
            });
        });
    </script>
</body>
</html>
