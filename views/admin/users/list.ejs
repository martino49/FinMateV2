<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        .status-active { background-color: #198754; }
        .status-inactive { background-color: #6c757d; }
        .role-admin { background-color: #dc3545; }
        .role-super_admin { background-color: #6f42c1; }
        .role-user { background-color: #0d6efd; }
        .role-team_member { background-color: #fd7e14; }
    </style>
</head>
<body>
    <%- include('../../partials/sidebar', { user: user, currentPage: 'users' }) %>
    <div class="fm-main">
        <nav class="fm-topbar">
            <div class="fm-topbar-left">
                <a class="fm-topbar-brand" href="/admin/dashboard">
                    <span class="fm-topbar-brand-icon"><i class="fas fa-chart-line"></i></span>
                    <span class="fm-topbar-brand-text">FinMate</span>
                </a>
                <button class="fm-topbar-hamburger" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
                <span class="fm-topbar-title">User Management</span>
            </div>
            <div class="fm-topbar-right">
                <a href="/admin/notifications"><i class="fas fa-bell"></i></a>
                <a href="/auth/logout" class="logout-link"><i class="fas fa-sign-out-alt"></i></a>
            </div>
        </nav>

        <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
            <h1 class="h2">
                <i class="fas fa-users me-2 text-primary"></i>
                User Management
            </h1>
            <div class="btn-toolbar mb-2 mb-md-0">
                <a href="/admin/users/add" class="btn btn-primary">
                    <i class="fas fa-user-plus me-1"></i>Add User
                </a>
            </div>
        </div>

        <!-- Success/Error Messages -->
        <% if (locals.query && locals.query.success) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>
                <%= locals.query.success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <% if (locals.query && locals.query.error) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>
                <%= locals.query.error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <!-- Users Table -->
        <div class="card shadow">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">
                    <i class="fas fa-list me-2"></i>All Users
                    <% if (locals.users && locals.users.length > 0) { %>
                        <span class="badge bg-primary ms-2"><%= locals.users.length %> users</span>
                    <% } %>
                </h5>
                <div class="text-muted small">
                    Showing all system users
                </div>
            </div>
            <div class="card-body">
                <% if (locals.users && locals.users.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Username</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th>Status</th>
                                    <th>Joined Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% locals.users.forEach(user => { %>
                                    <tr>
                                        <td><strong>#<%= user.id %></strong></td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px;">
                                                    <i class="fas fa-user text-white" style="font-size: 0.8rem;"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-bold"><%= user.username %></div>
                                                </div>
                                            </div>
                                        </td>
                                        <td><%= user.email %></td>
                                        <td>
                                            <span class="badge role-<%= user.role ? user.role.toLowerCase().replace(' ', '_') : 'user' %>">
                                                <i class="fas fa-<%= user.role === 'admin' || user.role === 'super_admin' ? 'crown' : 'user' %> me-1"></i>
                                                <%= user.role || 'User' %>
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge status-<%= user.is_active ? 'active' : 'inactive' %>">
                                                <i class="fas fa-<%= user.is_active ? 'check' : 'times' %>-circle me-1"></i>
                                                <%= user.is_active ? 'Active' : 'Inactive' %>
                                            </span>
                                        </td>
                                        <td>
                                            <small class="text-muted">
                                                <%= new Date(user.created_at).toLocaleDateString() %>
                                            </small>
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <a href="/admin/users/edit/<%= user.id %>" class="btn btn-outline-primary" title="Edit User">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <form action="/admin/users/delete/<%= user.id %>" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this user?');">
                                                    <button type="submit" class="btn btn-outline-danger" title="Delete User">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="text-center py-5">
                        <i class="fas fa-users fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">No Users Found</h5>
                        <p class="text-muted">There are no users in the system yet.</p>
                        <a href="/admin/users/add" class="btn btn-primary">
                            <i class="fas fa-user-plus me-1"></i>Add First User
                        </a>
                    </div>
                <% } %>
            </div>
        </div>
    </div><!-- end fm-main -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Auto-dismiss alerts after 5 seconds
        document.addEventListener('DOMContentLoaded', function() {
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                setTimeout(() => {
                    const bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                }, 5000);
            });
        });
    </script>
</body>
</html>
