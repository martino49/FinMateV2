<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
    <style>
        :root {
            --primary-color: #4e73df;
            --success-color: #1cc88a;
            --warning-color: #f6c23e;
            --danger-color: #e74a3b;
            --info-color: #36b9cc;
        }
        
        .page-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 16px;
            padding: 2.5rem 2rem;
            margin-bottom: 2.5rem;
            color: white;
            box-shadow: 0 8px 30px rgba(0,0,0,0.12);
        }
        
        .form-card {
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 0 30px rgba(0,0,0,0.06);
        }
    </style>
</head>
<body style="background: linear-gradient(135deg, #f8f9fc 0%, #e9ecef 100%); min-height: 100vh;">
    <%- include('../../partials/sidebar', { user: user, currentPage: 'permissions' }) %>
    <div class="fm-main">
        <nav class="fm-topbar">
            <div class="fm-topbar-left">
                <a class="fm-topbar-brand" href="/super-admin/dashboard">
                    <span class="fm-topbar-brand-icon"><i class="fas fa-chart-line"></i></span>
                    <span class="fm-topbar-brand-text">FinMate</span>
                </a>
                <button class="fm-topbar-hamburger" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
                <span class="fm-topbar-title">Add Permission</span>
            </div>
            <div class="fm-topbar-right">
                <a href="/super-admin/notifications"><i class="fas fa-bell"></i></a>
                <a href="/auth/logout" class="logout-link"><i class="fas fa-sign-out-alt"></i></a>
            </div>
        </nav>
                <!-- Page Header -->
                <div class="page-header animate__animated animate__fadeIn">
                    <div class="row align-items-center">
                        <div class="col">
                            <h1 class="h2 mb-2">
                                <i class="fas fa-key me-3"></i>
                                Add New Permission
                            </h1>
                            <p class="mb-0 opacity-85 fs-5">Create a new system permission</p>
                        </div>
                        <div class="col-auto">
                            <a href="/super-admin/permissions" class="btn btn-light btn-lg">
                                <i class="fas fa-arrow-left me-2"></i>Back to Permissions
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Alerts -->
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-danger alert-dismissible fade show animate__animated animate__shakeX" role="alert">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-exclamation-triangle me-3 fa-lg"></i>
                            <div>
                                <h6 class="alert-heading mb-1">Error</h6>
                                <p class="mb-0"><%= error %></p>
                            </div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>

                <!-- Add Permission Form -->
                <div class="card form-card shadow border-0 animate__animated animate__fadeIn">
                    <div class="card-header bg-white py-4 border-0">
                        <h5 class="card-title mb-0 text-dark fs-4">
                            <i class="fas fa-edit me-3 text-primary"></i>
                            Permission Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <form method="POST" action="/super-admin/permissions/add">
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <label for="name" class="form-label fw-bold">Permission Name <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control form-control-lg" id="name" name="name" 
                                           placeholder="e.g., manage_users" required>
                                    <div class="form-text">Use lowercase with underscores (e.g., view_reports)</div>
                                </div>
                                <div class="col-md-6">
                                    <label for="description" class="form-label fw-bold">Description</label>
                                    <input type="text" class="form-control form-control-lg" id="description" name="description" 
                                           placeholder="Brief description of this permission">
                                </div>
                                <div class="col-12">
                                    <label for="resource" class="form-label fw-bold">Resource</label>
                                    <input type="text" class="form-control form-control-lg" id="resource" name="resource" 
                                           placeholder="e.g., users, reports, settings">
                                    <div class="form-text">The resource this permission applies to (optional)</div>
                                </div>
                                <div class="col-12">
                                    <label for="action" class="form-label fw-bold">Action</label>
                                    <select class="form-select form-select-lg" id="action" name="action">
                                        <option value="">Select action type</option>
                                        <option value="read">Read (View)</option>
                                        <option value="write">Write (Create/Edit)</option>
                                        <option value="delete">Delete (Remove)</option>
                                        <option value="manage">Manage (Full Control)</option>
                                    </select>
                                    <div class="form-text">The type of action this permission allows (optional)</div>
                                </div>
                            </div>
                            
                            <hr class="my-4">
                            
                            <div class="d-flex justify-content-between">
                                <a href="/super-admin/permissions" class="btn btn-secondary btn-lg">
                                    <i class="fas fa-times me-2"></i>Cancel
                                </a>
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="fas fa-save me-2"></i>Create Permission
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
    </div>
    <!-- end fm-main -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Auto-dismiss alerts after 5 seconds
        setTimeout(() => {
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);
    </script>
</body>
</html>
