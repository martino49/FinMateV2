<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
    <style>
        :root {
            --primary-color: #4e73df;
            --success-color: #1cc88a;
            --warning-color: #f6c23e;
            --danger-color: #e74a3b;
            --info-color: #36b9cc;
            --dark-color: #5a5c69;
        }
        
        .page-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 16px;
            padding: 2.5rem 2rem;
            margin-bottom: 2.5rem;
            color: white;
            box-shadow: 0 8px 30px rgba(0,0,0,0.12);
        }
        
        .detail-card {
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 0 30px rgba(0,0,0,0.06);
        }
        
        .detail-label {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #6c757d;
            font-weight: 600;
            margin-bottom: 0.25rem;
        }
        
        .detail-value {
            font-size: 1rem;
            color: #2c3e50;
            font-weight: 500;
        }
        
        .action-badge {
            font-size: 0.85rem;
            padding: 0.6em 1.2em;
            border-radius: 50px;
            font-weight: 600;
        }
        
        .json-viewer {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 1rem;
            font-family: 'Courier New', monospace;
            font-size: 0.85rem;
            overflow-x: auto;
            border: 1px solid #e3e6f0;
        }
    </style>
</head>
<body style="background: linear-gradient(135deg, #f8f9fc 0%, #e9ecef 100%); min-height: 100vh;">
    <div class="container-fluid">
        <div class="row">
            <%- include('../../partials/superadmin-sidebar') %>
            
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                <!-- Page Header -->
                <div class="page-header animate__animated animate__fadeIn">
                    <div class="row align-items-center">
                        <div class="col">
                            <h1 class="h2 mb-2">
                                <i class="fas fa-clipboard-list me-3"></i>
                                Audit Log Details
                            </h1>
                            <p class="mb-0 opacity-85 fs-5">Detailed view of audit log entry</p>
                        </div>
                        <div class="col-auto">
                            <a href="/super-admin/audit-logs" class="btn btn-light btn-lg">
                                <i class="fas fa-arrow-left me-2"></i>Back to Logs
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Alerts -->
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-danger alert-dismissible fade show animate__animated animate__shakeX" role="alert">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-exclamation-triangle me-3 fa-lg"></i>
                            <div>
                                <h6 class="alert-heading mb-1">Error</h6>
                                <p class="mb-0"><%= error %></p>
                            </div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>
                <% if (typeof success !== 'undefined' && success) { %>
                    <div class="alert alert-success alert-dismissible fade show animate__animated animate__bounceIn" role="alert">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-check-circle me-3 fa-lg"></i>
                            <div>
                                <h6 class="alert-heading mb-1">Success</h6>
                                <p class="mb-0"><%= success %></p>
                            </div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>

                <% if (typeof auditLog !== 'undefined' && auditLog) { %>
                    <!-- Log Summary Card -->
                    <div class="card detail-card shadow border-0 mb-4 animate__animated animate__fadeIn">
                        <div class="card-header bg-white py-4 border-0">
                            <div class="row align-items-center">
                                <div class="col">
                                    <h5 class="card-title mb-0 text-dark fs-4">
                                        <i class="fas fa-info-circle me-3 text-primary"></i>
                                        Log Entry #<%= auditLog.id %>
                                    </h5>
                                </div>
                                <div class="col-auto">
                                    <% 
                                    let badgeClass = 'bg-secondary';
                                    if (auditLog.action && auditLog.action.includes('login')) badgeClass = 'bg-success';
                                    else if (auditLog.action && (auditLog.action.includes('create') || auditLog.action.includes('add'))) badgeClass = 'bg-primary';
                                    else if (auditLog.action && (auditLog.action.includes('update') || auditLog.action.includes('edit'))) badgeClass = 'bg-warning text-dark';
                                    else if (auditLog.action && (auditLog.action.includes('delete') || auditLog.action.includes('remove'))) badgeClass = 'bg-danger';
                                    else if (auditLog.action && (auditLog.action.includes('error') || auditLog.action.includes('fail'))) badgeClass = 'bg-dark';
                                    %>
                                    <span class="badge action-badge <%= badgeClass %>">
                                        <%= auditLog.action || 'Unknown' %>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <div class="detail-label">Action</div>
                                    <div class="detail-value"><%= auditLog.action || 'N/A' %></div>
                                </div>
                                <div class="col-md-6">
                                    <div class="detail-label">User</div>
                                    <div class="detail-value">
                                        <i class="fas fa-user me-1 text-muted"></i>
                                        <%= auditLog.username || 'System' %>
                                        <% if (auditLog.user_id) { %>
                                            <small class="text-muted">(ID: <%= auditLog.user_id %>)</small>
                                        <% } %>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="detail-label">Description</div>
                                    <div class="detail-value"><%= auditLog.description || 'No description provided' %></div>
                                </div>
                                <div class="col-md-6">
                                    <div class="detail-label">IP Address</div>
                                    <div class="detail-value">
                                        <code class="text-dark"><%= auditLog.ip_address || 'N/A' %></code>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="detail-label">Timestamp</div>
                                    <div class="detail-value">
                                        <i class="fas fa-clock me-1 text-muted"></i>
                                        <%= new Date(auditLog.created_at).toLocaleString('en-US', { 
                                            year: 'numeric', 
                                            month: 'long', 
                                            day: 'numeric',
                                            hour: '2-digit',
                                            minute: '2-digit',
                                            second: '2-digit'
                                        }) %>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="detail-label">User Agent</div>
                                    <div class="detail-value" style="word-break: break-all;">
                                        <small class="text-muted"><%= auditLog.user_agent || 'N/A' %></small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Old & New Values -->
                    <% if (auditLog.old_values || auditLog.new_values) { %>
                        <div class="row g-4 mb-4">
                            <% if (auditLog.old_values) { %>
                                <div class="col-md-6">
                                    <div class="card detail-card shadow border-0 animate__animated animate__fadeInLeft">
                                        <div class="card-header bg-white py-3 border-0">
                                            <h6 class="card-title mb-0">
                                                <i class="fas fa-minus-circle me-2 text-danger"></i>
                                                Previous Values
                                            </h6>
                                        </div>
                                        <div class="card-body">
                                            <div class="json-viewer">
                                                <pre class="mb-0"><%= typeof auditLog.old_values_parsed !== 'undefined' ? JSON.stringify(auditLog.old_values_parsed, null, 2) : (typeof auditLog.old_values === 'string' ? auditLog.old_values : JSON.stringify(auditLog.old_values, null, 2)) %></pre>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% } %>
                            <% if (auditLog.new_values) { %>
                                <div class="col-md-6">
                                    <div class="card detail-card shadow border-0 animate__animated animate__fadeInRight">
                                        <div class="card-header bg-white py-3 border-0">
                                            <h6 class="card-title mb-0">
                                                <i class="fas fa-plus-circle me-2 text-success"></i>
                                                New Values
                                            </h6>
                                        </div>
                                        <div class="card-body">
                                            <div class="json-viewer">
                                                <pre class="mb-0"><%= typeof auditLog.new_values_parsed !== 'undefined' ? JSON.stringify(auditLog.new_values_parsed, null, 2) : (typeof auditLog.new_values === 'string' ? auditLog.new_values : JSON.stringify(auditLog.new_values, null, 2)) %></pre>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    <% } %>
                <% } else { %>
                    <div class="card detail-card shadow border-0 animate__animated animate__fadeIn">
                        <div class="card-body text-center py-5">
                            <i class="fas fa-exclamation-triangle text-warning fa-3x mb-3"></i>
                            <h4 class="text-muted">Log Entry Not Found</h4>
                            <p class="text-muted">The requested audit log entry could not be found.</p>
                            <a href="/super-admin/audit-logs" class="btn btn-primary">
                                <i class="fas fa-arrow-left me-2"></i>Back to Audit Logs
                            </a>
                        </div>
                    </div>
                <% } %>
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Auto-dismiss alerts after 5 seconds
        setTimeout(() => {
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);
    </script>
</body>
</html>
