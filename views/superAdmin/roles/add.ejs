<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
    <style>
        :root {
            --primary-color: #4e73df;
            --success-color: #1cc88a;
            --warning-color: #f6c23e;
            --danger-color: #e74a3b;
            --info-color: #36b9cc;
        }
        
        .page-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 16px;
            padding: 2.5rem 2rem;
            margin-bottom: 2.5rem;
            color: white;
            box-shadow: 0 8px 30px rgba(0,0,0,0.12);
        }
        
        .form-card {
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 0 30px rgba(0,0,0,0.06);
        }
        
        .permission-item {
            border: 1px solid #e3e6f0;
            border-radius: 8px;
            padding: 0.75rem 1rem;
            margin-bottom: 0.5rem;
            transition: all 0.2s ease;
        }
        
        .permission-item:hover {
            background-color: #f8f9fe;
            border-color: var(--primary-color);
        }
        
        .permission-item input:checked + label {
            color: var(--primary-color);
            font-weight: 600;
        }
    </style>
</head>
<body style="background: linear-gradient(135deg, #f8f9fc 0%, #e9ecef 100%); min-height: 100vh;">
    <div class="container-fluid">
        <div class="row">
            <%- include('../../partials/superadmin-sidebar') %>
            
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                <!-- Page Header -->
                <div class="page-header animate__animated animate__fadeIn">
                    <div class="row align-items-center">
                        <div class="col">
                            <h1 class="h2 mb-2">
                                <i class="fas fa-user-plus me-3"></i>
                                Add New Role
                            </h1>
                            <p class="mb-0 opacity-85 fs-5">Create a new role with specific permissions</p>
                        </div>
                        <div class="col-auto">
                            <a href="/super-admin/roles" class="btn btn-light btn-lg">
                                <i class="fas fa-arrow-left me-2"></i>Back to Roles
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Alerts -->
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-danger alert-dismissible fade show animate__animated animate__shakeX" role="alert">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-exclamation-triangle me-3 fa-lg"></i>
                            <div>
                                <h6 class="alert-heading mb-1">Error</h6>
                                <p class="mb-0"><%= error %></p>
                            </div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>

                <!-- Add Role Form -->
                <div class="card form-card shadow border-0 animate__animated animate__fadeIn">
                    <div class="card-header bg-white py-4 border-0">
                        <h5 class="card-title mb-0 text-dark fs-4">
                            <i class="fas fa-edit me-3 text-primary"></i>
                            Role Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <form method="POST" action="/super-admin/roles/add">
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <label for="name" class="form-label fw-bold">Role Name <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control form-control-lg" id="name" name="name" 
                                           placeholder="e.g., team_leader" required>
                                    <div class="form-text">Use lowercase with underscores (e.g., team_member)</div>
                                </div>
                                <div class="col-md-6">
                                    <label for="description" class="form-label fw-bold">Description</label>
                                    <input type="text" class="form-control form-control-lg" id="description" name="description" 
                                           placeholder="Brief description of this role">
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-bold">Permissions</label>
                                    <p class="text-muted mb-3">Select the permissions to assign to this role:</p>
                                    
                                    <% if (typeof permissions !== 'undefined' && permissions && permissions.length > 0) { %>
                                        <div class="row">
                                            <% permissions.forEach(permission => { %>
                                                <div class="col-md-4 col-sm-6">
                                                    <div class="permission-item">
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="checkbox" 
                                                                   id="perm_<%= permission.id %>" 
                                                                   name="permissions" 
                                                                   value="<%= permission.id %>">
                                                            <label class="form-check-label" for="perm_<%= permission.id %>">
                                                                <%= permission.name %>
                                                                <% if (permission.description) { %>
                                                                    <br><small class="text-muted"><%= permission.description %></small>
                                                                <% } %>
                                                            </label>
                                                        </div>
                                                    </div>
                                                </div>
                                            <% }); %>
                                        </div>
                                    <% } else { %>
                                        <div class="alert alert-info">
                                            <i class="fas fa-info-circle me-2"></i>
                                            No permissions available. Create permissions first before assigning them to roles.
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                            
                            <hr class="my-4">
                            
                            <div class="d-flex justify-content-between">
                                <a href="/super-admin/roles" class="btn btn-secondary btn-lg">
                                    <i class="fas fa-times me-2"></i>Cancel
                                </a>
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="fas fa-save me-2"></i>Create Role
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Auto-dismiss alerts after 5 seconds
        setTimeout(() => {
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);
    </script>
</body>
</html>
