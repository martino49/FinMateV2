<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Budget Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        html,
        body {
            height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #f8f9fc;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }


        .page-header {
            background: #fff;
            border-radius: 10px;
            padding: 1.5rem;
            margin-bottom: 2rem;
            box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.1);
        }

        .stat-card {
            border-radius: 10px;
            transition: transform 0.3s, box-shadow 0.3s;
            border: none;
            box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
            overflow: hidden;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 0.5rem 2rem 0 rgba(58, 59, 69, 0.2);
        }

        .border-left-primary {
            border-left: 4px solid var(--primary) !important;
        }

        .border-left-success {
            border-left: 4px solid var(--success) !important;
        }

        .border-left-warning {
            border-left: 4px solid var(--warning) !important;
        }

        .border-left-info {
            border-left: 4px solid var(--info) !important;
        }

        .border-left-danger {
            border-left: 4px solid var(--danger) !important;
        }

        .budget-card {
            transition: transform 0.3s, box-shadow 0.3s;
            height: 100%;
            border: none;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.1);
        }

        .budget-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 0.5rem 2rem 0 rgba(58, 59, 69, 0.2);
        }

        .budget-card .card-header {
            background: #fff;
            border-bottom: 1px solid #e3e6f0;
            font-weight: 600;
            padding: 1rem 1.25rem;
        }

        .budget-card .card-body {
            padding: 1.25rem;
        }

        .budget-card .card-footer {
            background: rgba(248, 249, 252, 0.8);
            border-top: 1px solid #e3e6f0;
            padding: 1rem 1.25rem;
        }

        .progress {
            height: 10px;
            border-radius: 5px;
        }

        .progress-bar {
            border-radius: 5px;
        }

        .btn {
            border-radius: 8px;
            font-weight: 500;
            transition: all 0.3s;
        }

        .btn-primary {
            background: var(--primary);
            border-color: var(--primary);
        }

        .btn-success {
            background: var(--success);
            border-color: var(--success);
        }

        .btn-warning {
            background: var(--warning);
            border-color: var(--warning);
        }

        .btn-info {
            background: var(--info);
            border-color: var(--info);
        }

        .btn-danger {
            background: var(--danger);
            border-color: var(--danger);
        }

        .empty-state {
            padding: 3rem 1rem;
            text-align: center;
            color: #6c757d;
        }

        .empty-state i {
            font-size: 3rem;
            margin-bottom: 1rem;
            opacity: 0.5;
        }

        .badge {
            font-size: 0.7em;
            padding: 4px 8px;
        }

        .text-xs {
            font-size: 0.75rem;
        }

        .text-gray-800 {
            color: var(--dark) !important;
        }

        .text-gray-300 {
            color: #dddfeb !important;
        }

        .font-weight-bold {
            font-weight: 700 !important;
        }

        .no-gutters {
            margin-right: 0;
            margin-left: 0;
        }

        .no-gutters>.col,
        .no-gutters>[class*="col-"] {
            padding-right: 0;
            padding-left: 0;
        }

        .quick-action-card {
            transition: all 0.3s;
            border-radius: 10px;
            border: none;
            box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.1);
            height: 100%;
        }

        .quick-action-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 0.5rem 2rem 0 rgba(58, 59, 69, 0.2);
        }

        .quick-action-card .card-body {
            padding: 2rem 1rem;
        }

        .quick-action-card i {
            font-size: 2.5rem;
            margin-bottom: 1rem;
        }

        /* Mobile responsiveness */
        @media (max-width: 768px) {
            .budget-card {
                margin-bottom: 1.5rem;
            }
        }

        /* Animation for cards */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .fade-in-up {
            animation: fadeInUp 0.5s ease-out;
        }
    </style>
</head>

<body>
<%- include('../../partials/sidebar', { user: user, currentPage: 'budgets', notificationCount: typeof notificationCount !== 'undefined' ? notificationCount : 0 }) %>
<div class="fm-main">
    <nav class="fm-topbar">
        <div class="fm-topbar-left">
            <a class="fm-topbar-brand" href="/user/dashboard">
                <span class="fm-topbar-brand-icon"><i class="fas fa-chart-line"></i></span>
                <span class="fm-topbar-brand-text">FinMate</span>
            </a>
            <button class="fm-topbar-hamburger" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
            <span class="fm-topbar-title">Budget Management</span>
        </div>
        <div class="fm-topbar-right">
            <a href="/user/notifications"><i class="fas fa-bell"></i></a>
            <a href="/auth/logout" class="logout-link"><i class="fas fa-sign-out-alt"></i></a>
        </div>
    </nav>
                    <div class="p-3 p-md-4">

                        <!-- Page Header -->
                        <div
                            class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 page-header">
                            <div class="d-flex align-items-center">
                                <h1 class="h2 mb-0">
                                    <i class="fas fa-wallet me-2 text-primary"></i>
                                    Budget Management
                                </h1>
                            </div>
                            <a href="/user/budgets/add" class="btn btn-primary">
                                <i class="fas fa-plus me-2"></i>Add Budget
                            </a>
                        </div>

                        <!-- Success/Error Messages -->
                        <% if (success && message) { %>
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <i class="fas fa-check-circle me-2"></i>
                                <%= message %>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                            <% } %>

                                <% if (error) { %>
                                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                        <i class="fas fa-exclamation-circle me-2"></i>
                                        <%= error %>
                                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                    </div>
                                    <% } %>

                                        <!-- Summary Cards -->
                                        <div class="row mb-4">
                                            <div class="col-xl-3 col-md-6 mb-4 fade-in-up">
                                                <div class="card border-left-primary shadow h-100 py-2 stat-card">
                                                    <div class="card-body">
                                                        <div class="row no-gutters align-items-center">
                                                            <div class="col mr-2">
                                                                <div
                                                                    class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                                                    Total Budgets</div>
                                                                <div class="h5 mb-0 font-weight-bold text-gray-800">
                                                                    <%= budgets ? budgets.length : 0 %>
                                                                </div>
                                                            </div>
                                                            <div class="col-auto">
                                                                <i class="fas fa-wallet fa-2x text-gray-300"></i>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-xl-3 col-md-6 mb-4 fade-in-up">
                                                <div class="card border-left-success shadow h-100 py-2 stat-card">
                                                    <div class="card-body">
                                                        <div class="row no-gutters align-items-center">
                                                            <div class="col mr-2">
                                                                <div
                                                                    class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                                                    Total Budgeted</div>
                                                                <div class="h5 mb-0 font-weight-bold text-gray-800">
                                                                    Ksh <%= budgets ? budgets.reduce(function(sum, b) {
                                                                        return sum + parseFloat(b.amount || 0); },
                                                                        0).toFixed(2) : '0.00' %>
                                                                </div>
                                                            </div>
                                                            <div class="col-auto">
                                                                <i class="fas fa-target fa-2x text-gray-300"></i>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-xl-3 col-md-6 mb-4 fade-in-up">
                                                <div class="card border-left-info shadow h-100 py-2 stat-card">
                                                    <div class="card-body">
                                                        <div class="row no-gutters align-items-center">
                                                            <div class="col mr-2">
                                                                <div
                                                                    class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                                                    Total Spent</div>
                                                                <div class="h5 mb-0 font-weight-bold text-gray-800">
                                                                    Ksh <%= budgets ? budgets.reduce(function(sum, b) {
                                                                        return sum + parseFloat(b.spent_amount || 0); },
                                                                        0).toFixed(2) : '0.00' %>
                                                                </div>
                                                            </div>
                                                            <div class="col-auto">
                                                                <i class="fas fa-chart-line fa-2x text-gray-300"></i>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-xl-3 col-md-6 mb-4 fade-in-up">
                                                <div class="card border-left-warning shadow h-100 py-2 stat-card">
                                                    <div class="card-body">
                                                        <div class="row no-gutters align-items-center">
                                                            <div class="col mr-2">
                                                                <div
                                                                    class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                                                    Avg Usage</div>
                                                                <div class="h5 mb-0 font-weight-bold text-gray-800">
                                                                    <%= budgets && budgets.length > 0 ?
                                                                        Math.round(budgets.reduce(function(sum, b) {
                                                                        const
                                                                        spent = parseFloat(b.spent_amount || 0); const
                                                                        amount = parseFloat(b.amount || 0); return sum +
                                                                        (amount > 0 ? (spent / amount) * 100 : 0); }, 0)
                                                                        /
                                                                        budgets.length) : 0 %>%
                                                                </div>
                                                            </div>
                                                            <div class="col-auto">
                                                                <i class="fas fa-percentage fa-2x text-gray-300"></i>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Quick Actions -->
                                        <div class="row mb-4">
                                            <div class="col-12">
                                                <div class="card shadow">
                                                    <div class="card-header">
                                                        <h5 class="card-title mb-0">
                                                            <i class="fas fa-bolt me-2"></i>Quick Actions
                                                        </h5>
                                                    </div>
                                                    <div class="card-body">
                                                        <div class="row text-center">
                                                            <div class="col-md-4 col-sm-6 mb-3">
                                                                <a href="/user/budgets/add"
                                                                    class="card quick-action-card text-decoration-none">
                                                                    <div class="card-body text-primary">
                                                                        <i class="fas fa-plus-circle"></i><br>
                                                                        <h5>Add Budget</h5>
                                                                        <p class="text-muted small">Create a new budget
                                                                            category</p>
                                                                    </div>
                                                                </a>
                                                            </div>
                                                            <div class="col-md-4 col-sm-6 mb-3">
                                                                <a href="/user/expenses"
                                                                    class="card quick-action-card text-decoration-none">
                                                                    <div class="card-body text-success">
                                                                        <i class="fas fa-receipt"></i><br>
                                                                        <h5>View Expenses</h5>
                                                                        <p class="text-muted small">Track your spending
                                                                        </p>
                                                                    </div>
                                                                </a>
                                                            </div>
                                                            <div class="col-md-4 col-sm-6 mb-3">
                                                                <a href="/user/reports"
                                                                    class="card quick-action-card text-decoration-none">
                                                                    <div class="card-body text-info">
                                                                        <i class="fas fa-chart-bar"></i><br>
                                                                        <h5>View Reports</h5>
                                                                        <p class="text-muted small">Analyze your
                                                                            finances
                                                                        </p>
                                                                    </div>
                                                                </a>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Budgets Grid -->
                                        <div class="row">
                                        <% if (budgets && budgets.length > 0) { %>
                                        <% budgets.forEach(function(budget) { %>
                                        <% var spent = parseFloat(budget.spent_amount || 0); %>
                                        <% var amount = parseFloat(budget.amount || 0); %>
                                        <% var remaining = amount - spent; %>
                                        <% var pct = amount > 0 ? (spent / amount) * 100 : 0; %>
                                        <% var pClass = pct >= 90 ? 'danger' : pct >= 75 ? 'warning' : 'success'; %>
                                        <% var sIcon = pct >= 100 ? 'fa-exclamation-triangle' : pct >= 75 ? 'fa-warning' : 'fa-check-circle'; %>
                                        <% var catLower = budget.category ? budget.category.toLowerCase() : ''; %>
                                        <% var icons = { 'housing':'home', 'food':'utensils', 'transportation':'car', 'entertainment':'film', 'healthcare':'heartbeat', 'shopping':'shopping-bag', 'utilities':'bolt', 'education':'graduation-cap', 'travel':'plane', 'food & dining':'utensils', 'personal care':'user', 'team expenses':'users' }; %>
                                        <% var colors = { 'housing':'primary', 'food':'success', 'transportation':'info', 'entertainment':'warning', 'healthcare':'danger', 'shopping':'secondary', 'food & dining':'success', 'personal care':'info', 'team expenses':'primary' }; %>
                                        <% var bIcon = icons[catLower] || 'wallet'; %>
                                        <% var bColor = colors[catLower] || 'primary'; %>
                                            <div class="col-xl-4 col-lg-6 mb-4 fade-in-up">
                                                <div class="card shadow budget-card h-100">
                                                    <div class="card-header d-flex justify-content-between align-items-center">
                                                        <h5 class="card-title mb-0">
                                                            <i class="fas fa-<%= bIcon %> me-2 text-<%= bColor %>"></i>
                                                            <%= budget.name || budget.category || 'Uncategorized' %>
                                                        </h5>
                                                        <span class="badge bg-<%= pct >= 100 ? 'danger' : 'primary' %>">
                                                            <i class="fas <%= sIcon %> me-1"></i><%= pct.toFixed(1) %>%
                                                        </span>
                                                    </div>
                                                    <div class="card-body">
                                                        <p class="card-text text-muted small mb-3">
                                                            <i class="fas fa-info-circle me-1"></i>
                                                            <%= budget.period %> budget for <%= budget.category %>
                                                        </p>
                                                        <div class="mb-3">
                                                            <div class="d-flex justify-content-between mb-2">
                                                                <small class="text-muted">Spent: <strong>Ksh <%= spent.toFixed(2) %></strong></small>
                                                                <small class="text-muted">Budget: <strong>Ksh <%= amount.toFixed(2) %></strong></small>
                                                            </div>
                                                            <div class="progress" style="height: 8px;">
                                                                <div class="progress-bar bg-<%= pClass %>" role="progressbar" style="width: <%= Math.min(pct, 100) %>%" aria-valuenow="<%= pct %>" aria-valuemin="0" aria-valuemax="100"></div>
                                                            </div>
                                                            <div class="d-flex justify-content-between mt-2">
                                                                <small class="text-<%= remaining < 0 ? 'danger' : 'success' %>">
                                                                    <strong><%= remaining >= 0 ? 'Ksh ' + remaining.toFixed(2) + ' left' : 'Ksh ' + Math.abs(remaining).toFixed(2) + ' over' %></strong>
                                                                </small>
                                                                <small class="text-muted"><%= new Date().toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) %></small>
                                                            </div>
                                                        </div>
                                                        <% if (budget.start_date || budget.end_date) { %>
                                                        <div class="d-flex align-items-center text-muted small mb-2">
                                                            <i class="fas fa-calendar me-2"></i>
                                                            <span>
                                                                <% if (budget.start_date) { %><%= new Date(budget.start_date).toLocaleDateString() %><% } %>
                                                                <% if (budget.end_date) { %> - <%= new Date(budget.end_date).toLocaleDateString() %><% } %>
                                                            </span>
                                                        </div>
                                                        <% } %>
                                                        <% if (budget.created_at) { %>
                                                        <div class="d-flex align-items-center text-muted small">
                                                            <i class="fas fa-clock me-2"></i>
                                                            <span>Created <%= new Date(budget.created_at).toLocaleDateString() %></span>
                                                        </div>
                                                        <% } %>
                                                    </div>
                                                    <div class="card-footer bg-transparent">
                                                        <div class="d-flex gap-2">
                                                            <a href="/user/budgets/edit/<%= budget.id %>" class="btn btn-outline-primary btn-sm flex-fill">
                                                                <i class="fas fa-edit me-1"></i>Edit
                                                            </a>
                                                            <form action="/user/budgets/delete/<%= budget.id %>" method="POST" class="flex-fill" onsubmit="return confirm('Are you sure?')">
                                                                <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                                                    <i class="fas fa-trash me-1"></i>Delete
                                                                </button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        <% }) %>
                                        <% } else { %>
                                            <div class="col-12">
                                                <div class="card shadow">
                                                    <div class="card-body text-center py-5 empty-state">
                                                        <i class="fas fa-wallet fa-3x text-muted mb-3"></i>
                                                        <h5 class="text-muted">No Budgets Found</h5>
                                                        <p class="text-muted mb-4">Start managing your finances by creating your first budget.</p>
                                                        <div class="d-flex gap-2 justify-content-center">
                                                            <a href="/user/budgets/add" class="btn btn-primary"><i class="fas fa-plus me-2"></i>Create Your First Budget</a>
                                                            <a href="/user/dashboard" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Back to Dashboard</a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        <% } %>
                                        </div>

                                        <!-- Quick Stats -->
                                        <% if (budgets && budgets.length > 0) { %>
                                            <div class="row mt-5">
                                                <div class="col-12">
                                                    <div class="card shadow">
                                                        <div class="card-header">
                                                            <h5 class="card-title mb-0">
                                                                <i class="fas fa-chart-pie me-2 text-primary"></i>
                                                                Budget Overview
                                                            </h5>
                                                        </div>
                                                        <div class="card-body">
                                                            <div class="row text-center">
                                                                <div class="col-md-3 mb-3">
                                                                    <div class="stat-item">
                                                                        <h3 class="text-primary">
                                                                            <%= budgets.length %>
                                                                        </h3>
                                                                        <p class="text-muted mb-0">Total Budgets</p>
                                                                    </div>
                                                                </div>
                                                                <div class="col-md-3 mb-3">
                                                                    <div class="stat-item">
                                                                        <h3 class="text-success">
                                                                            Ksh <%= budgets.reduce(function(sum, b) {
                                                                                return sum + parseFloat(b.amount || 0);
                                                                                }, 0).toFixed(0) %>
                                                                        </h3>
                                                                        <p class="text-muted mb-0">Total Budgeted</p>
                                                                    </div>
                                                                </div>
                                                                <div class="col-md-3 mb-3">
                                                                    <div class="stat-item">
                                                                        <h3 class="text-info">
                                                                            Ksh <%= budgets.reduce(function(sum, b) {
                                                                                return sum + parseFloat(b.spent_amount
                                                                                || 0); }, 0).toFixed(0) %>
                                                                        </h3>
                                                                        <p class="text-muted mb-0">Total Spent</p>
                                                                    </div>
                                                                </div>
                                                                <div class="col-md-3 mb-3">
                                                                    <div class="stat-item">
                                                                        <h3 class="text-warning">
                                                                            <%= Math.round(budgets.reduce(function(sum,
                                                                                b) { const
                                                                                spent=parseFloat(b.spent_amount || 0);
                                                                                const amount=parseFloat(b.amount || 0);
                                                                                return sum + (amount > 0 ? (spent /
                                                                                amount) *
                                                                                100 : 0); }, 0) / budgets.length) %>%
                                                                        </h3>
                                                                        <p class="text-muted mb-0">Average Usage</p>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <% } %>
                
</div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>

        // Auto-dismiss alerts after 5 seconds
        document.addEventListener('DOMContentLoaded', function () {
            setTimeout(function () {
                var alerts = document.querySelectorAll('.alert');
                alerts.forEach(function (alert) {
                    var bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);
        });
    </script>
<!-- end fm-main -->
</div>
</body>

</html>