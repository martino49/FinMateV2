<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        </style>
</head>
<body>
<%- include('../../partials/sidebar', { user: user, currentPage: 'planned-expenses', notificationCount: typeof notificationCount !== 'undefined' ? notificationCount : 0 }) %>
<div class="fm-main">
    <nav class="fm-topbar">
        <div class="fm-topbar-left">
            <a class="fm-topbar-brand" href="/user/dashboard">
                <span class="fm-topbar-brand-icon"><i class="fas fa-chart-line"></i></span>
                <span class="fm-topbar-brand-text">FinMate</span>
            </a>
            <button class="fm-topbar-hamburger" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
            <span class="fm-topbar-title">Planned Expenses</span>
        </div>
        <div class="fm-topbar-right">
            <a href="/user/notifications"><i class="fas fa-bell"></i></a>
            <a href="/auth/logout" class="logout-link"><i class="fas fa-sign-out-alt"></i></a>
        </div>
    </nav>
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">
                        <i class="fas fa-calendar-alt me-2 text-primary"></i>
                        Planned Expenses
                    </h1>
                    <a href="/user/planned-expenses/add" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Add Planned Expense
                    </a>
                </div>

                <!-- Alerts -->
                <% if (typeof success !== 'undefined' && success) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <%= message %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>
                
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <%= error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>

                <div class="card shadow">
                    <div class="card-body">
                        <% if (plannedExpenses && plannedExpenses.length > 0) { %>
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead>
                                        <tr>
                                            <th>Description</th>
                                            <th>Amount</th>
                                            <th>Category</th>
                                            <th>Planned Date</th>
                                            <th>Recurrence</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% plannedExpenses.forEach(expense => { %>
                                            <tr>
                                                <td><%= expense.description %></td>
                                                <td>$<%= Number(expense.amount).toFixed(2) %></td>
                                                <td>
                                                    <span class="badge bg-secondary"><%= expense.category %></span>
                                                </td>
                                                <td><%= new Date(expense.planned_date).toLocaleDateString() %></td>
                                                <td>
                                                    <span class="badge bg-info"><%= expense.recurrence %></span>
                                                </td>
                                                <td>
                                                    <a href="/user/planned-expenses/edit/<%= expense.id %>" class="btn btn-sm btn-outline-primary">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <form action="/user/planned-expenses/delete/<%= expense.id %>" method="POST" class="d-inline">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger" 
                                                                onclick="return confirm('Are you sure you want to delete this planned expense?')">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } else { %>
                            <div class="text-center py-5">
                                <i class="fas fa-calendar-alt fa-3x text-muted mb-3"></i>
                                <h5 class="text-muted">No planned expenses found</h5>
                                <p class="text-muted">Start by adding your first planned expense</p>
                                <a href="/user/planned-expenses/add" class="btn btn-primary">Add Planned Expense</a>
                            </div>
                        <% } %>
                    </div>
                </div>
            
</div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
<!-- end fm-main -->
</div>
</body>
</html>
