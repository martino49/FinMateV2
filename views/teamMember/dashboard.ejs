<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Team Member Dashboard - FinMate</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .stat-card {
            transition: transform 0.2s;
            cursor: pointer;
        }
        .stat-card:hover {
            transform: translateY(-2px);
        }
        .quick-action-btn {
            transition: all 0.3s;
        }
        .quick-action-btn:hover {
            transform: scale(1.05);
        }
    </style>
</head>
<body>
    <%- include('../partials/sidebar', { user: user, currentPage: 'dashboard' }) %>
    <div class="fm-main">
        <nav class="fm-topbar">
            <div class="fm-topbar-left">
                <a class="fm-topbar-brand" href="/team-member/dashboard">
                    <span class="fm-topbar-brand-icon"><i class="fas fa-chart-line"></i></span>
                    <span class="fm-topbar-brand-text">FinMate</span>
                </a>
                <button class="fm-topbar-hamburger" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
                <span class="fm-topbar-title">Team Member Dashboard</span>
            </div>
            <div class="fm-topbar-right">
                <a href="/auth/logout" class="logout-link"><i class="fas fa-sign-out-alt"></i></a>
            </div>
        </nav>

        <!-- Page Content -->
        <div class="container-fluid py-4">
            <!-- Statistics Cards -->
            <div class="row mb-4">
                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-primary shadow h-100 py-2 stat-card" onclick="loadRoute('/team-member/expenses')">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                        Active Members</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800" id="activeMembers">
                                        <i class="fas fa-spinner fa-spin"></i>
                                    </div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-users fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-warning shadow h-100 py-2 stat-card" onclick="loadRoute('/team-member/expenses')">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                        Pending Expenses</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800" id="pendingExpenses">
                                        <i class="fas fa-spinner fa-spin"></i>
                                    </div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-clock fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-success shadow h-100 py-2 stat-card" onclick="loadRoute('/team-member/expenses')">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                        Total Expenses</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800" id="totalExpenses">
                                        <i class="fas fa-spinner fa-spin"></i>
                                    </div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-money-bill-wave fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-info shadow h-100 py-2 stat-card" onclick="loadRoute('/team-member/planned-expenses')">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                        Total Spent</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800" id="totalSpent">
                                        <i class="fas fa-spinner fa-spin"></i>
                                    </div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-dollar-sign fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card shadow">
                        <div class="card-header py-3">
                            <h6 class="m-0 font-weight-bold text-primary">Quick Actions</h6>
                        </div>
                        <div class="card-body">
                            <div class="row text-center">
                                <div class="col-md-3 mb-3">
                                    <a href="/team-member/expenses" class="btn btn-primary btn-lg quick-action-btn w-100">
                                        <i class="fas fa-receipt fa-2x mb-2"></i><br>
                                        My Expenses
                                    </a>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <a href="/team-member/planned-expenses" class="btn btn-success btn-lg quick-action-btn w-100">
                                        <i class="fas fa-calendar-check fa-2x mb-2"></i><br>
                                        Planned Expenses
                                    </a>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <a href="/team-member/expenses" class="btn btn-info btn-lg quick-action-btn w-100">
                                        <i class="fas fa-plus-circle fa-2x mb-2"></i><br>
                                        Add Expense
                                    </a>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <a href="/team-member/planned-expenses" class="btn btn-warning btn-lg quick-action-btn w-100">
                                        <i class="fas fa-calendar-plus fa-2x mb-2"></i><br>
                                        Plan Expense
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Budget Overview & Team Performance -->
            <div class="row">
                <div class="col-lg-6 mb-4">
                    <div class="card shadow">
                        <div class="card-header py-3 d-flex justify-content-between align-items-center">
                            <h6 class="m-0 font-weight-bold text-primary">Budget Overview</h6>
                        </div>
                        <div class="card-body">
                            <div id="budgetOverview">
                                <div class="text-center py-4">
                                    <i class="fas fa-spinner fa-spin fa-2x text-muted"></i>
                                    <p class="mt-2 text-muted">Loading budget data...</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6 mb-4">
                    <div class="card shadow">
                        <div class="card-header py-3 d-flex justify-content-between align-items-center">
                            <h6 class="m-0 font-weight-bold text-primary">Team Performance</h6>
                        </div>
                        <div class="card-body">
                            <div id="teamPerformance">
                                <div class="text-center py-4">
                                    <i class="fas fa-spinner fa-spin fa-2x text-muted"></i>
                                    <p class="mt-2 text-muted">Loading performance data...</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div><!-- end fm-main -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Load dashboard data when page loads
        document.addEventListener('DOMContentLoaded', function() {
            loadTeamStats();
            loadBudgetOverview();
            loadTeamPerformance();
        });

        // Load team statistics
        async function loadTeamStats() {
            try {
                const response = await fetch('/team-member/api/team-stats');
                const data = await response.json();
                
                document.getElementById('activeMembers').textContent = data.active_members || 0;
                document.getElementById('pendingExpenses').textContent = data.pending_expenses || 0;
                document.getElementById('totalExpenses').textContent = data.total_expenses || 0;
                document.getElementById('totalSpent').textContent = '$' + (data.total_spent || 0).toLocaleString();
            } catch (error) {
                console.error('Error loading team stats:', error);
                document.getElementById('activeMembers').textContent = '0';
                document.getElementById('pendingExpenses').textContent = '0';
                document.getElementById('totalExpenses').textContent = '0';
                document.getElementById('totalSpent').textContent = '$0';
            }
        }

        // Load budget overview
        async function loadBudgetOverview() {
            try {
                const response = await fetch('/team-member/api/budget-overview');
                const data = await response.json();
                
                const budgetOverview = document.getElementById('budgetOverview');
                budgetOverview.innerHTML = '<div class="mb-3">' +
                    '<div class="d-flex justify-content-between mb-1"><span>Total Budgets:</span><strong>' + (data.total_budgets || 0) + '</strong></div>' +
                    '<div class="d-flex justify-content-between mb-1"><span>Total Amount:</span><strong>$' + (data.total_amount || 0).toLocaleString() + '</strong></div>' +
                    '<div class="d-flex justify-content-between"><span>Total Spent:</span><strong>$' + (data.total_spent || 0).toLocaleString() + '</strong></div>' +
                    '</div>' +
                    '<div class="progress mb-3" style="height: 20px;">' +
                    '<div class="progress-bar bg-success" role="progressbar" style="width: ' + ((data.total_spent / data.total_amount) * 100 || 0) + '%">' +
                    Math.round(((data.total_spent / data.total_amount) * 100) || 0) + '%</div></div>' +
                    '<small class="text-muted">Budget utilization</small>';
            } catch (error) {
                console.error('Error loading budget overview:', error);
                document.getElementById('budgetOverview').innerHTML = '<p class="text-muted">Unable to load budget data</p>';
            }
        }

        // Load team performance
        async function loadTeamPerformance() {
            try {
                const response = await fetch('/team-member/api/member-performance');
                const data = await response.json();
                
                const teamPerformance = document.getElementById('teamPerformance');
                if (data && data.length > 0) {
                    let html = '<div class="table-responsive"><table class="table table-sm">';
                    html += '<thead><tr><th>Member</th><th>Expenses</th><th>Amount</th></tr></thead><tbody>';
                    data.forEach(function(member) {
                        html += '<tr><td>' + member.name + '</td><td>' + member.expenses + '</td><td>$' + member.amount + '</td></tr>';
                    });
                    html += '</tbody></table></div>';
                    teamPerformance.innerHTML = html;
                } else {
                    teamPerformance.innerHTML = '<p class="text-muted">No performance data available</p>';
                }
            } catch (error) {
                console.error('Error loading team performance:', error);
                document.getElementById('teamPerformance').innerHTML = '<p class="text-muted">Unable to load performance data</p>';
            }
        }

        // Utility function to load routes
        function loadRoute(url) {
            window.location.href = url;
        }
    </script>
</body>
</html>
